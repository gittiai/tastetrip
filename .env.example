# Qloo Taste AI hackathon key (https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide)
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
# Live Google Flights fares via SerpAPI (free: 250 searches/month). Without it, cards link to Google Flights instead.
SERPAPI_KEY=
# Model provider, first one set wins:
# 1. APInex (OpenAI-compatible, https://apinex.bond), default model free/gpt-6-luna
APINEX_API_KEY=
# 2. Groq, default model openai/gpt-oss-120b
GROQ_API_KEY=
# 3. Vercel AI Gateway (not needed on Vercel, which uses OIDC), default anthropic/claude-sonnet-5.5
AI_GATEWAY_API_KEY=
# Optional: override the provider's default model id
MODEL=
